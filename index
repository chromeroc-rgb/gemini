    // ==========================================
    // RENDERIZADO VISUAL CASI 3D (BLOQUES ISOMÉTRICOS Y BISELADOS)
    // ==========================================
    function drawBlock(context, x, y, colorIdx) {
      const palette = PIECE_COLORS[colorIdx % PIECE_COLORS.length];
      const px = x * BLOCK_SIZE;
      const py = y * BLOCK_SIZE;
      const sz = BLOCK_SIZE;
      const b = 5; // tamaño de bisel para profundidad 3D

      context.save();

      // Cara central con gradiente de luz diagonal
      const baseGrad = context.createLinearGradient(px, py, px + sz, py + sz);
      baseGrad.addColorStop(0, palette.top);
      baseGrad.addColorStop(0.5, palette.base);
      baseGrad.addColorStop(1, palette.bottom);
      context.fillStyle = baseGrad;
      context.fillRect(px, py, sz, sz);

      // Bisel Superior (Luz directa)
      context.fillStyle = "rgba(255, 255, 255, 0.45)";
      context.beginPath();
      context.moveTo(px, py);
      context.lineTo(px + sz, py);
      context.lineTo(px + sz - b, py + b);
      context.lineTo(px + b, py + b);
      context.closePath();
      context.fill();

      // Bisel Izquierdo (Reflejo ambiental)
      context.fillStyle = "rgba(255, 255, 255, 0.25)";
      context.beginPath();
      context.moveTo(px, py);
      context.lineTo(px + b, py + b);
      context.lineTo(px + b, py + sz - b);
      context.lineTo(px, py + sz);
      context.closePath();
      context.fill();

      // Bisel Derecho (Sombra media)
      context.fillStyle = "rgba(0, 0, 0, 0.35)";
      context.beginPath();
      context.moveTo(px + sz, py);
      context.lineTo(px + sz, py + sz);
      context.lineTo(px + sz - b, py + sz - b);
      context.lineTo(px + sz - b, py + b);
      context.closePath();
      context.fill();

      // Bisel Inferior (Sombra profunda de oclusión)
      context.fillStyle = "rgba(0, 0, 0, 0.6)";
      context.beginPath();
      context.moveTo(px, py + sz);
      context.lineTo(px + b, py + sz - b);
      context.lineTo(px + sz - b, py + sz - b);
      context.lineTo(px + sz, py + sz);
      context.closePath();
      context.fill();

      // Cara interior brillante tipo gema 3D
      const innerSize = sz - 2 * b;
      const innerGrad = context.createLinearGradient(px + b, py + b, px + b, py + b + innerSize);
      innerGrad.addColorStop(0, "rgba(255, 255, 255, 0.35)");
      innerGrad.addColorStop(0.4, "rgba(255, 255, 255, 0.05)");
      innerGrad.addColorStop(1, "rgba(0, 0, 0, 0.25)");
      context.fillStyle = innerGrad;
      context.fillRect(px + b, py + b, innerSize, innerSize);

      // Destello especular en esquina superior izquierda
      context.fillStyle = "#ffffff";
      context.beginPath();
      context.arc(px + b + 2.5, py + b + 2.5, 1.8, 0, Math.PI * 2);
      context.fill();

      // Contorno fino para definición
      context.strokeStyle = "rgba(0, 0, 0, 0.4)";
      context.lineWidth = 1;
      context.strokeRect(px + 0.5, py + 0.5, sz - 1, sz - 1);

      context.restore();
    }

    function render() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Rejilla con casillas hundidas 3D
      for (let r = 0; r < ROWS; r++) {
        for (let c = 0; c < COLS; c++) {
          const gx = c * BLOCK_SIZE;
          const gy = r * BLOCK_SIZE;
          ctx.fillStyle = "rgba(0, 26, 13, 0.75)";
          ctx.fillRect(gx + 1, gy + 1, BLOCK_SIZE - 2, BLOCK_SIZE - 2);
          ctx.strokeStyle = "rgba(0, 255, 128, 0.08)";
          ctx.strokeRect(gx + 0.5, gy + 0.5, BLOCK_SIZE, BLOCK_SIZE);
        }
      }

      // Bloques fijados en el tablero
      for (let r = 0; r < ROWS; r++) {
        for (let c = 0; c < COLS; c++) {
          if (board[r][c] !== 0) {
            drawBlock(ctx, c, r, board[r][c] - 1);
          }
        }
      }

      // Pieza Fantasma y Pieza Actual
      if (currentPiece) {
        let ghostY = currentPiece.y;
        while (!checkCollision(currentPiece.shape, currentPiece.x, ghostY + 1)) {
          ghostY++;
        }
        if (ghostY > currentPiece.y) {
          ctx.globalAlpha = 0.25;
          for (let r = 0; r < currentPiece.shape.length; r++) {
            for (let c = 0; c < currentPiece.shape[r].length; c++) {
              if (currentPiece.shape[r][c]) {
                drawBlock(ctx, currentPiece.x + c, ghostY + r, currentPiece.colorIdx);
              }
            }
          }
          ctx.globalAlpha = 1.0;
        }

        for (let r = 0; r < currentPiece.shape.length; r++) {
          for (let c = 0; c < currentPiece.shape[r].length; c++) {
            if (currentPiece.shape[r][c]) {
              drawBlock(ctx, currentPiece.x + c, currentPiece.y + r, currentPiece.colorIdx);
            }
          }
        }
      }
      renderNextPiece();
    }

    function renderNextPiece() {
      nextCtx.clearRect(0, 0, nextCanvas.width, nextCanvas.height);
      if (!nextPiece) return;
      const shape = nextPiece.shape;
      const offX = Math.floor((4 - shape[0].length) / 2);
      const offY = Math.floor((4 - shape.length) / 2);
      const miniSize = 18;

      for (let r = 0; r < shape.length; r++) {
        for (let c = 0; c < shape[r].length; c++) {
          if (shape[r][c]) {
            const px = (offX + c) * miniSize + 4;
            const py = (offY + r) * miniSize + 4;
            const pal = PIECE_COLORS[nextPiece.colorIdx % PIECE_COLORS.length];
            nextCtx.fillStyle = pal.base;
            nextCtx.fillRect(px, py, miniSize, miniSize);
            nextCtx.fillStyle = pal.top;
            nextCtx.fillRect(px, py, miniSize, 3);
            nextCtx.fillStyle = pal.right;
            nextCtx.fillRect(px + miniSize - 3, py, 3, miniSize);
          }
        }
      }
    }

    function getNewPiece() {
      const idx = Math.floor(Math.random() * PIECES.length);
      const p = PIECES[idx];
      return {
        shape: p.shape.map(row => [...row]),
        colorIdx: p.colorIdx,
        x: Math.floor((COLS - p.shape[0].length) / 2),
        y: 0
      };
    }

    function checkCollision(shape, posX, posY) {
      for (let r = 0; r < shape.length; r++) {
        for (let c = 0; c < shape[r].length; c++) {
          if (shape[r][c]) {
            const nextX = posX + c;
            const nextY = posY + r;
            if (nextX < 0 || nextX >= COLS || nextY >= ROWS) return true;
            if (nextY >= 0 && board[nextY][nextX] !== 0) return true;
          }
        }
      }
      return false;
    }

    function rotateShape(shape, clockwise = true) {
      const H = shape.length;
      const W = shape[0].length;
      const rotated = Array.from({ length: W }, () => Array(H).fill(0));
      for (let r = 0; r < H; r++) {
        for (let c = 0; c < W; c++) {
          if (clockwise) {
            rotated[c][H - 1 - r] = shape[r][c];
          } else {
            rotated[W - 1 - c][r] = shape[r][c];
          }
        }
      }
      return rotated;
    }

    function moveLeft() {
      if (!currentPiece || isPaused || triviaActive || isGameOver) return;
      if (!checkCollision(currentPiece.shape, currentPiece.x - 1, currentPiece.y)) {
        currentPiece.x--;
        audio.playMove();
        render();
      }
    }
    function moveRight() {
      if (!currentPiece || isPaused || triviaActive || isGameOver) return;
      if (!checkCollision(currentPiece.shape, currentPiece.x + 1, currentPiece.y)) {
        currentPiece.x++;
        audio.playMove();
        render();
      }
    }
    function rotatePiece(clockwise = true) {
      if (!currentPiece || isPaused || triviaActive || isGameOver) return;
      const rotated = rotateShape(currentPiece.shape, clockwise);
      const offsets = [0, -1, 1, -2, 2];
      let rotatedSuccess = false;

      for (let dx of offsets) {
        if (!checkCollision(rotated, currentPiece.x + dx, currentPiece.y)) {
          currentPiece.shape = rotated;
          currentPiece.x += dx;
          rotatedSuccess = true;
          audio.playRotate();
          vibrate(20);
          break;
        }
      }
      if (rotatedSuccess) {
        render();
      }
    }
    function softDrop() {
      if (!currentPiece || isPaused || triviaActive || isGameOver) return;
      if (!checkCollision(currentPiece.shape, currentPiece.x, currentPiece.y + 1)) {
        currentPiece.y++;
        score += 1;
        updateUI();
        render();
      } else {
        lockPiece();
      }
    }
    function hardDrop() {
      if (!currentPiece || isPaused || triviaActive || isGameOver) return;
      let dropCount = 0;
      while (!checkCollision(currentPiece.shape, currentPiece.x, currentPiece.y + 1)) {
        currentPiece.y++;
        dropCount++;
      }
      score += dropCount * 2;
      audio.playDrop();
      vibrate(40);
      updateUI();
      lockPiece();
    }

    function lockPiece() {
      for (let r = 0; r < currentPiece.shape.length; r++) {
        for (let c = 0; c < currentPiece.shape[r].length; c++) {
          if (currentPiece.shape[r][c]) {
            const by = currentPiece.y + r;
            const bx = currentPiece.x + c;
            if (by < 0) {
              triggerGameOver();
              return;
            }
            board[by][bx] = currentPiece.colorIdx + 1;
          }
        }
      }

      clearLines();
      currentPiece = nextPiece;
      nextPiece = getNewPiece();

      if (checkCollision(currentPiece.shape, currentPiece.x, currentPiece.y)) {
        triggerGameOver();
        return;
      }
      render();
    }

    function clearLines() {
      let linesCleared = 0;
      for (let r = ROWS - 1; r >= 0; r--) {
        if (board[r].every(cell => cell !== 0)) {
          board.splice(r, 1);
          board.unshift(Array(COLS).fill(0));
          linesCleared++;
          r++;
        }
      }

      if (linesCleared > 0) {
        totalLines += linesCleared;
        linesInCurrentLevel += linesCleared;

        const baseScores = [0, 100, 300, 600, 1200];
        let earnedScore = (baseScores[linesCleared] || 1200) * currentLevel;
        score += earnedScore;

        depositToChanchito(linesCleared * 25);
        vibrate(50);

        if (linesCleared >= 4) {
          triggerExtraPlusCombo();
        } else {
          audio.playLineClear();
        }

        checkLevelProgression();
        updateUI();

        // Trivias financieras periódicas
        if (score >= nextTriviaThreshold && !triviaActive) {
          nextTriviaThreshold = score + 550;
          setTimeout(() => openTriviaModal(), 650);
        }
      }
    }

    // ==========================================
    // PROGRESIÓN DINÁMICA DE 5 NIVELES (FÁCIL A DIFÍCIL)
    // ==========================================
    function checkLevelProgression() {
      const cfg = LEVEL_CONFIG[currentLevel - 1];
      if (linesInCurrentLevel >= cfg.linesReq) {
        if (currentLevel < 5) {
          currentLevel++;
          linesInCurrentLevel = 0;
          applyLevelTheme(currentLevel);
          triggerLevelUpCelebration(currentLevel);
        } else {
          // Completado el Nivel 5: Victoria Final
          setTimeout(() => triggerVictory(), 600);
        }
      }
    }

    function triggerLevelUpCelebration(lvl) {
      audio.playLevelUp();
      vibrate([80, 40, 80, 40, 120]);
      depositToChanchito(100);

      const cfg = LEVEL_CONFIG[lvl - 1];
      levelUpBannerTitle.textContent = `¡¡NIVEL ${lvl} (${cfg.diff.toUpperCase()})!!`;
      levelUpBannerSub.textContent = `${cfg.name.toUpperCase()} • +S/ 100 AL CHANCHITO`;
      levelUpBanner.classList.add('active');

      canvasFrame.classList.add('shake-screen');
      setTimeout(() => canvasFrame.classList.remove('shake-screen'), 600);
      setTimeout(() => levelUpBanner.classList.remove('active'), 2400);
    }

    function applyLevelTheme(lvl) {
      const cfg = LEVEL_CONFIG[lvl - 1];
      document.documentElement.style.setProperty('--lvl-primary', cfg.primary);
      document.documentElement.style.setProperty('--lvl-border', cfg.border);
      document.documentElement.style.setProperty('--lvl-glow', cfg.glow);

      levelValEl.textContent = cfg.level;
      levelNameValEl.textContent = `${cfg.name} (${cfg.diff})`;
      dropInterval = cfg.speed;

      updateLevelsTrackUI();
      resetDropInterval();
    }

    function updateUI() {
      scoreValEl.textContent = score;
      linesValEl.textContent = totalLines;
      levelValEl.textContent = currentLevel;

      const cfg = LEVEL_CONFIG[currentLevel - 1];
      const remaining = Math.max(0, cfg.linesReq - linesInCurrentLevel);
      if (currentLevel === 5) {
        levelGoalValEl.textContent = `¡Meta Final! Faltan ${remaining} líneas`;
      } else {
        levelGoalValEl.textContent = `Faltan ${remaining} líneas para Nivel ${currentLevel + 1} (${LEVEL_CONFIG[currentLevel].diff})`;
      }

      const pct = Math.min(100, Math.round((linesInCurrentLevel / cfg.linesReq) * 100));
      levelSubBarFillEl.style.width = pct + '%';
    }

    function triggerExtraPlusCombo() {
      audio.playExtraPlusFanfare();
      vibrate([60, 40, 60, 40, 100]);
      canvasFrame.classList.add('shake-screen');
      extraPlusBanner.classList.add('active');
      depositToChanchito(100);

      setTimeout(() => canvasFrame.classList.remove('shake-screen'), 700);
      setTimeout(() => extraPlusBanner.classList.remove('active'), 2500);
    }

    function depositToChanchito(soles) {
      savingsAmount += soles;
      audio.playCoinClink();
      chanchitoSvgWrap.classList.add('chanchito-bounce');
      setTimeout(() => chanchitoSvgWrap.classList.remove('chanchito-bounce'), 500);

      const pct = Math.min(100, Math.round((savingsAmount / 1000) * 100));
      chanchitoProgressBar.style.width = pct + '%';
      savingsAmountTxt.textContent = `Ahorro: S/ ${savingsAmount}`;
      savingsMiniValEl.textContent = `S/ ${savingsAmount}`;
    }

    function resetDropInterval() {
      if (dropTimer) clearInterval(dropTimer);
      if (!isPaused && !triviaActive && !isGameOver) {
        dropTimer = setInterval(() => softDrop(), dropInterval);
      }
    }

    // ==========================================
    // TRIVIA INTERACTIVA (10 SEGUNDOS)
    // ==========================================
    let currentTrivia = null;
    function openTriviaModal() {
      triviaActive = true;
      clearInterval(dropTimer);

      currentTrivia = TRIVIA_POOL[Math.floor(Math.random() * TRIVIA_POOL.length)];
      questionTextEl.textContent = currentTrivia.q;
      answerFeedbackEl.className = 'answer-feedback';
      answerFeedbackEl.textContent = '';

      optionsContainerEl.innerHTML = '';
      const letters = ['A', 'B', 'C'];
      currentTrivia.opts.forEach((optText, i) => {
        const btn = document.createElement('button');
        btn.className = 'btn-option';
        btn.innerHTML = `<span class="opt-letter">${letters[i]}</span> <span>${optText}</span>`;
        btn.onclick = () => handleAnswer(i);
        optionsContainerEl.appendChild(btn);
      });

      triviaCountdown = 10;
      timerSecondsEl.textContent = triviaCountdown;
      timerBarEl.style.transition = 'none';
      timerBarEl.style.width = '100%';
      setTimeout(() => {
        timerBarEl.style.transition = 'width 10s linear';
        timerBarEl.style.width = '0%';
      }, 50);

      triviaModal.classList.add('open');

      if (triviaInterval) clearInterval(triviaInterval);
      triviaInterval = setInterval(() => {
        triviaCountdown--;
        timerSecondsEl.textContent = triviaCountdown;
        if (triviaCountdown <= 0) {
          clearInterval(triviaInterval);
          handleTimeout();
        }
      }, 1000);
    }

    function handleAnswer(selectedIdx) {
      clearInterval(triviaInterval);
      const isCorrect = (selectedIdx === currentTrivia.correct);
      
      const btns = optionsContainerEl.querySelectorAll('.btn-option');
      btns.forEach((btn, idx) => {
        btn.disabled = true;
        if (idx === currentTrivia.correct) {
          btn.style.borderColor = '#00ff73';
          btn.style.background = 'rgba(0, 255, 115, 0.25)';
        } else if (idx === selectedIdx) {
          btn.style.borderColor = '#ff3b30';
          btn.style.background = 'rgba(255, 59, 48, 0.25)';
        }
      });

      if (isCorrect) {
        audio.playCorrect();
        vibrate([50, 50, 100]);
        score += 350;
        depositToChanchito(50);
        answerFeedbackEl.style.color = '#00ff73';
        answerFeedbackEl.textContent = `¡Respuesta Correcta! +350 Pts y S/ 50 al Chanchito. ${currentTrivia.tip}`;
      } else {
        audio.playWrong();
        vibrate(150);
        answerFeedbackEl.style.color = '#ffc20e';
        answerFeedbackEl.textContent = `¡Casi! ${currentTrivia.tip}`;
      }

      answerFeedbackEl.classList.add('show');
      updateUI();

      setTimeout(() => {
        triviaModal.classList.remove('open');
        triviaActive = false;
        resetDropInterval();
      }, 2300);
    }

    function handleTimeout() {
      audio.playWrong();
      vibrate(150);
      const btns = optionsContainerEl.querySelectorAll('.btn-option');
      btns.forEach((btn, idx) => {
        btn.disabled = true;
        if (idx === currentTrivia.correct) {
          btn.style.borderColor = '#00ff73';
          btn.style.background = 'rgba(0, 255, 115, 0.25)';
        }
      });
      answerFeedbackEl.style.color = '#ffc20e';
      answerFeedbackEl.textContent = `¡Tiempo cumplido! ${currentTrivia.tip}`;
      answerFeedbackEl.classList.add('show');

      setTimeout(() => {
        triviaModal.classList.remove('open');
        triviaActive = false;
        resetDropInterval();
      }, 2300);
    }

    // ==========================================
    // PANTALLAS DE FIN DE JUEGO Y REGISTRO AL FORMULARIO
    // ==========================================
    function showFinalLeadModal(isVictory) {
      clearInterval(dropTimer);
      isPaused = true;
      modalScoreDisplay.textContent = score.toLocaleString();
      modalStatsDisplay.textContent = `Nivel: ${currentLevel} (${LEVEL_CONFIG[currentLevel-1].name}) • Líneas: ${totalLines} • Chanchito: S/ ${savingsAmount}`;

      if (isVictory) {
        audio.playExtraPlusFanfare();
        document.getElementById('modal-celebration-icon').textContent = '👑';
        document.getElementById('modal-final-title').textContent = '¡CAMPEÓN FINANCIERO NIVEL 5!';
        document.getElementById('modal-final-desc').innerHTML = `
          ¡Increíble hazaña! Has completado los <strong>5 Niveles de Dificultad</strong> de ProTetris.
          <br>Estás en una posición inmejorable para clasificar en el <strong>TOP 3 de jugadores</strong> y entrar al sorteo de la <strong>Tablet Lenovo</strong>.
        `;
      } else {
        audio.playWrong();
        document.getElementById('modal-celebration-icon').textContent = '📊';
        document.getElementById('modal-final-title').textContent = '¡FIN DE LA PARTIDA!';
        document.getElementById('modal-final-desc').innerHTML = `
          ¡Gran desempeño! Llegaste al <strong>Nivel ${currentLevel}</strong> y demostraste tu agilidad financiera.
          <br>Registra tus puntos en el formulario para competir por un lugar en el <strong>TOP 3</strong> y ganar la <strong>Tablet Lenovo</strong>.
        `;
      }

      leadModal.classList.add('open');
    }

    function triggerVictory() {
      showFinalLeadModal(true);
    }

    function triggerGameOver() {
      isGameOver = true;
      showFinalLeadModal(false);
    }

    // Copiar puntaje al portapapeles
    btnCopyScore.onclick = () => {
      const textToCopy = `Puntaje ProTetris ProEmpresa: ${score} puntos (Nivel ${currentLevel}, ${totalLines} líneas, S/ ${savingsAmount} en Chanchito)`;
      if (window.navigator && window.navigator.clipboard && window.navigator.clipboard.writeText) {
        navigator.clipboard.writeText(textToCopy).then(() => {
          btnCopyScore.innerHTML = '<span>✅ ¡Puntaje Copiado! Pégalo en el Formulario</span>';
          setTimeout(() => {
            btnCopyScore.innerHTML = '<span>📋 Copiar Puntaje al Portapapeles</span>';
          }, 2500);
        }).catch(() => {
          prompt('Copia tu puntaje:', score);
        });
      } else {
        prompt('Copia tu puntaje:', score);
      }
    };

    // ==========================================
    // GESTIÓN DE TÉRMINOS Y CONDICIONES
    // ==========================================
    function openTermsModal() {
      termsModal.classList.add('open');
    }
    function closeTermsModal() {
      termsModal.classList.remove('open');
    }

    document.getElementById('btn-open-terms-header').onclick = openTermsModal;
    document.getElementById('btn-open-terms-start').onclick = openTermsModal;
    document.getElementById('btn-open-terms-modal').onclick = openTermsModal;
    document.getElementById('btn-close-terms').onclick = closeTermsModal;

    // ==========================================
    // FLUJO DE INICIO Y SELECTOR DE NIVEL
    // ==========================================
    function updateStartLevelDisplay() {
      const cfg = LEVEL_CONFIG[selectedStartLevel - 1];
      startLevelBadge.textContent = `Nivel ${selectedStartLevel} (${cfg.diff})`;
      startLevelBadge.style.borderColor = cfg.border;
      startLevelBadge.style.color = cfg.border;
    }

    document.getElementById('btn-lvl-minus').onclick = () => {
      if (selectedStartLevel > 1) {
        selectedStartLevel--;
        updateStartLevelDisplay();
        audio.playMove();
      }
    };
    document.getElementById('btn-lvl-plus').onclick = () => {
      if (selectedStartLevel < 5) {
        selectedStartLevel++;
        updateStartLevelDisplay();
        audio.playMove();
      }
    };

    function startGame() {
      initBoard();
      score = 0;
      totalLines = 0;
      currentLevel = selectedStartLevel;
      linesInCurrentLevel = 0;
      savingsAmount = 0;
      isGameOver = false;
      isPaused = false;
      triviaActive = false;
      nextTriviaThreshold = 450;

      applyLevelTheme(currentLevel);
      updateUI();
      chanchitoProgressBar.style.width = '0%';
      savingsAmountTxt.textContent = 'Ahorro: S/ 0';
      savingsMiniValEl.textContent = 'S/ 0';

      currentPiece = getNewPiece();
      nextPiece = getNewPiece();

      startScreen.classList.add('hidden');
      leadModal.classList.remove('open');
      triviaModal.classList.remove('open');
      termsModal.classList.remove('open');
      pauseBtn.textContent = '⏸';

      audio.init();
      resetDropInterval();
      render();
    }

    function goToHome() {
      clearInterval(dropTimer);
      clearInterval(triviaInterval);
      isPaused = true;
      triviaActive = false;
      
      triviaModal.classList.remove('open');
      leadModal.classList.remove('open');
      termsModal.classList.remove('open');
      startScreen.classList.remove('hidden');
      pauseBtn.textContent = '⏸';
      updateLevelsTrackUI();
    }

    function togglePause() {
      if (isGameOver || triviaActive || !startScreen.classList.contains('hidden')) return;
      isPaused = !isPaused;
      if (isPaused) {
        clearInterval(dropTimer);
        pauseBtn.textContent = '▶️';
      } else {
        resetDropInterval();
        pauseBtn.textContent = '⏸';
      }
    }

    function toggleAudio() {
      audio.enabled = !audio.enabled;
      soundBtn.textContent = audio.enabled ? '🔊' : '🔇';
    }

    // ==========================================
    // CONTROLES DE TECLADO (PC)
    // ==========================================
    window.addEventListener('keydown', (e) => {
      if (e.code === 'KeyH' || e.code === 'Home') {
        goToHome();
        e.preventDefault();
        return;
      }
      if ((isGameOver || leadModal.classList.contains('open')) && e.code === 'KeyR') {
        startGame();
        return;
      }
      if (triviaActive) return;

      switch (e.code) {
        case 'ArrowLeft':
        case 'KeyA':
          moveLeft();
          e.preventDefault();
          break;
        case 'ArrowRight':
        case 'KeyD':
          moveRight();
          e.preventDefault();
          break;
        case 'ArrowUp':
        case 'KeyW':
        case 'KeyX':
          rotatePiece(true);
          e.preventDefault();
          break;
        case 'KeyZ':
          rotatePiece(false);
          e.preventDefault();
          break;
        case 'ArrowDown':
        case 'KeyS':
          softDrop();
          e.preventDefault();
          break;
        case 'Space':
          hardDrop();
          e.preventDefault();
          break;
        case 'KeyP':
        case 'Escape':
          togglePause();
          e.preventDefault();
          break;
        case 'KeyR':
          if (!startScreen.classList.contains('hidden')) startGame();
          break;
      }
    });

    // ==========================================
    // CONTROLES TÁCTILES CON REPETICIÓN (MÓVIL)
    // ==========================================
    function setupTouchButton(buttonId, actionFn, allowRepeat = false) {
      const btn = document.getElementById(buttonId);
      if (!btn) return;
      let repeatTimer = null;
      let initialTimer = null;

      const startAction = (e) => {
        if (e.cancelable) e.preventDefault();
        audio.init();
        btn.classList.add('active');
        actionFn();

        if (allowRepeat) {
          clearTimeout(initialTimer);
          clearInterval(repeatTimer);
          initialTimer = setTimeout(() => {
            repeatTimer = setInterval(() => {
              actionFn();
            }, 60);
          }, 180);
        }
      };

      const stopAction = (e) => {
        btn.classList.remove('active');
        clearTimeout(initialTimer);
        clearInterval(repeatTimer);
      };

      btn.addEventListener('touchstart', startAction, { passive: false });
      btn.addEventListener('touchend', stopAction, { passive: false });
      btn.addEventListener('touchcancel', stopAction, { passive: false });
      btn.addEventListener('mousedown', startAction);
      btn.addEventListener('mouseup', stopAction);
      btn.addEventListener('mouseleave', stopAction);
    }

    setupTouchButton('m-left', moveLeft, true);
    setupTouchButton('m-right', moveRight, true);
    setupTouchButton('m-down', softDrop, true);
    setupTouchButton('m-up', () => rotatePiece(true), false);
    setupTouchButton('m-rotate', () => rotatePiece(true), false);
    setupTouchButton('m-hard', hardDrop, false);

    // ==========================================
    // GESTOS TÁCTILES EN EL CANVAS (SWIPE / TAP)
    // ==========================================
    let touchStartX = 0;
    let touchStartY = 0;
    let touchStartTime = 0;

    canvas.addEventListener('touchstart', (e) => {
      if (e.touches.length > 0) {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        touchStartTime = Date.now();
        audio.init();
      }
      e.preventDefault();
    }, { passive: false });

    canvas.addEventListener('touchmove', (e) => {
      e.preventDefault();
    }, { passive: false });

    canvas.addEventListener('touchend', (e) => {
      if (e.changedTouches.length === 0) return;
      const dx = e.changedTouches[0].clientX - touchStartX;
      const dy = e.changedTouches[0].clientY - touchStartY;
      const dt = Date.now() - touchStartTime;
      const absX = Math.abs(dx);
      const absY = Math.abs(dy);

      if (absX < 15 && absY < 15 && dt < 250) {
        rotatePiece(true);
      } else if (absX > absY && absX > 25) {
        if (dx > 0) moveRight();
        else moveLeft();
      } else if (absY > absX && absY > 25) {
        if (dy > 0) {
          if (absY > 70 && dt < 200) {
            hardDrop();
          } else {
            softDrop();
          }
        }
      }
      e.preventDefault();
    }, { passive: false });

    // Eventos de botones
    document.getElementById('btn-start-game').onclick = startGame;
    document.getElementById('btn-restart-game').onclick = startGame;
    document.getElementById('btn-home-from-modal').onclick = goToHome;
    homeBtn.onclick = goToHome;
    pauseBtn.onclick = togglePause;
    soundBtn.onclick = toggleAudio;

    // Desbloqueo de audio al primer clic/toque
    document.addEventListener('pointerdown', () => audio.init(), { once: true });

    // Inicialización al cargar la página
    initLevelsTrack();
    updateStartLevelDisplay();
    initBoard();
    render();
  </script>
</body>
</html>
